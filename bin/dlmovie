#!/bin/sh
# dlmovie - Linux/Steam Deck launcher. The Windows equivalent is dlmovie.cmd at the repo root.
# All the shared work (pwsh discovery, argument translation) lives in _dl-launcher.sh.

set -eu

# Resolve this script through any symlinks before locating its siblings. Putting a
# launcher on PATH means linking it into ~/.local/bin, and `dirname $0` would then name
# the link's directory - where neither the shared body nor the repo lives.
DL_SELF=$0
while [ -L "$DL_SELF" ]; do
    dl_link=$(readlink -- "$DL_SELF")
    case $dl_link in
        /*) DL_SELF=$dl_link ;;
        *)  DL_SELF=$(dirname -- "$DL_SELF")/$dl_link ;;
    esac
done
DL_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$DL_SELF")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$DL_BIN_DIR/.." && pwd)
PS_SCRIPT="$REPO_ROOT/dlmovie/Add-Movie.ps1"
DL_ARG_STYLE=passthrough
VALUE_FLAGS=""

dl_usage() {
    cat <<'USAGE'
Usage: dlmovie "Movie Name" [destination] [-Interactive] [-DryRun] [-MaxResults N]
USAGE
}

if [ $# -eq 0 ]; then dl_usage; exit 0; fi

. "$DL_BIN_DIR/_dl-launcher.sh"
