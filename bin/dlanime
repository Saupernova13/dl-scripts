#!/bin/sh
# dlanime - Linux/Steam Deck launcher. The Windows equivalent is dlanime.cmd at the repo root.
# All the shared work (pwsh discovery, argument translation) lives in _dl-launcher.sh.

set -eu

# Resolve this script through any symlinks before locating its siblings. Putting a
# launcher on PATH means linking it into ~/.local/bin, and `dirname $0` would then name
# the link's directory - where neither the shared body nor the repo lives.
DL_SELF=$0
while [ -L "$DL_SELF" ]; do
    dl_link=$(readlink -- "$DL_SELF")
    case $dl_link in
        /*) DL_SELF=$dl_link ;;
        *)  DL_SELF=$(dirname -- "$DL_SELF")/$dl_link ;;
    esac
done
DL_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$DL_SELF")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$DL_BIN_DIR/.." && pwd)
PS_SCRIPT="$REPO_ROOT/dlanime/Add-Anime.ps1"
DL_POSITIONALS="Query Destination"
DL_ANIME_TYPE=1
DL_FLAG_SWITCHES="--list:ListOnly --dry-run:DryRun --dryrun:DryRun --links-only:DryRun --interactive:Interactive --trusted-only:TrustedOnly"
DL_FLAG_VALUES="--dest:Destination --destination:Destination --qbit-host:QbitHost --max-results:MaxResults --filter:Filter"

dl_usage() {
    cat <<'USAGE'
Usage: dlanime "Anime Name" [series|movie] [destination] [flags]

  --list           show the top 100 results with every magnet, download nothing
  --dry-run        show the matches and the torrent it would add, download nothing
  --interactive    pick from the results instead of auto-selecting
  --trusted-only   only consider torrents from trusted uploaders
  --max-results N  cap how many results are considered
  --filter TEXT    keep only results matching TEXT
  --dest PATH      override the destination
USAGE
}

if [ $# -eq 0 ]; then dl_usage; exit 0; fi

. "$DL_BIN_DIR/_dl-launcher.sh"
