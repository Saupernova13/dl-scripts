#!/bin/sh
# Install (or remove) the Desktop Mode autostart entry that drains the deferred Steam
# sync queue. Steam Deck / any XDG desktop. No root required.
#
#   dlrom-install-autostart            install
#   dlrom-install-autostart --remove   uninstall
#   dlrom-install-autostart --status   show what is currently installed
#
# An XDG autostart entry rather than a systemd user unit: Game Mode and Desktop Mode are both
# graphical sessions of the same user, so a unit bound to graphical-session.target fires in
# BOTH - precisely the case the queue exists to avoid. ~/.config/autostart is processed by the
# Plasma session only. The drain refuses to run in Game Mode anyway, so this is belt-and-braces.

set -eu

# Resolve symlinks first: a launcher linked into ~/.local/bin would otherwise resolve
# `dirname $0` to the link's directory, where the repo does not live.
SELF=$0
while [ -L "$SELF" ]; do
    link=$(readlink -- "$SELF")
    case $link in
        /*) SELF=$link ;;
        *)  SELF=$(dirname -- "$SELF")/$link ;;
    esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
DLROM="$BIN_DIR/dlrom"
RUNNER="$BIN_DIR/dlrom-autostart-sync"
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
ENTRY="$AUTOSTART_DIR/dlrom-sync-steam.desktop"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dlScripts"

case "${1:-}" in
    --remove|-r)
        if [ -f "$ENTRY" ]; then rm -f "$ENTRY"; echo "Removed $ENTRY"; else echo "Not installed."; fi
        exit 0
        ;;
    --status|-s)
        if [ -f "$ENTRY" ]; then
            echo "Installed: $ENTRY"
            echo
            cat "$ENTRY"
        else
            echo "Not installed."
        fi
        exit 0
        ;;
    --help|-h)
        sed -n '2,20p' "$0"
        exit 0
        ;;
esac

if [ ! -x "$DLROM" ]; then
    echo "[ERROR] dlrom launcher not found or not executable: $DLROM" >&2
    echo "Run: chmod +x \"$DLROM\"" >&2
    exit 1
fi

if [ ! -x "$RUNNER" ]; then
    echo "[ERROR] autostart runner not found or not executable: $RUNNER" >&2
    echo "Run: chmod +x \"$RUNNER\"" >&2
    exit 1
fi

mkdir -p "$AUTOSTART_DIR" "$LOG_DIR"

# Exec is a bare path to dlrom-autostart-sync, which holds the startup delay, the queue test
# and --no-game-mode. Exec is not a shell command line: ';', '>', '|', '&', '*' and quotes are
# reserved there, and a launcher may mangle a value containing them without reporting anything.
cat > "$ENTRY" <<EOF
[Desktop Entry]
Type=Application
Name=dlrom deferred Steam sync
Comment=Adds ROMs downloaded during Game Mode to Steam via Steam ROM Manager
Exec=$RUNNER
Icon=steam
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=false
EOF

echo "Installed: $ENTRY"
echo "Log:       $LOG_DIR/sync-steam.log"
echo
echo "Queued Steam syncs will now be applied automatically when Desktop Mode starts."
echo "Check the queue at any time with: dlrom --steam-queue"
