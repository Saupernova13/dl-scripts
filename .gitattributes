# Batch wrappers MUST keep CRLF in the working tree.
#
# cmd.exe seeks by byte offset when it resolves `goto`, and with LF-only line endings that
# seek lands mid-line once the file is long enough - the label is then "not found". It fails
# silently and positionally, so it shows up as one subcommand breaking after an unrelated
# edit grew the file. dlrom.cmd hit exactly this.
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell reads either on either platform, so CRLF stays for consistency with the
# batch wrappers even though these now also run under pwsh on Linux.
*.ps1 text eol=crlf

# Shell launchers MUST be LF. A CRLF shebang makes the kernel look for an interpreter
# named "/bin/sh\r", and the only symptom is a bare "no such file or directory" naming a
# shell that plainly exists.
bin/*  text eol=lf
*.sh   text eol=lf

# Everything else follows the platform default.
*.md   text
*.py   text
*.json text
